# MQTT over TLS。复制为 .env 后填写真实值；不要提交 .env。
MQTT_HOST=<broker-host>
MQTT_PORT=8883
MQTT_USERNAME=<readonly-subscriber-username>
MQTT_PASSWORD=<readonly-subscriber-password>
MQTT_DEVICE_ID=device01
MQTT_TOPIC_ROOT=smartcane
MQTT_CLIENT_ID=smartcane-web-device01

# 留空时使用操作系统的受信任 CA；私有 CA 时填写 PEM 文件路径。
MQTT_CA_FILE=

# 本机调试默认值。绑定公网地址时必须同时设置网页账号和密码。
WEB_HOST=127.0.0.1
WEB_PORT=8080
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
SMARTCANE_DEMO=false

