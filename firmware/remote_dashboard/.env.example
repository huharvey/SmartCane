# MQTT-TLS connection. MQTT_HOST is the hostname assigned by EMQX Cloud; it is
# not the ECS public IP and not the optional dashboard domain. Never commit the
# real password.
MQTT_HOST=replace-with-emqx-hostname
MQTT_PORT=8883
MQTT_USERNAME=replace-with-read-only-username
MQTT_PASSWORD=replace-with-password
MQTT_DEVICE_ID=device01
MQTT_TOPIC_ROOT=smartcane
MQTT_CLIENT_ID=smartcane-web-device01
# Leave empty to use the operating system trust store.
MQTT_CA_FILE=

# Server-side AMap Web Service key. It is never returned to the browser.
# Leave empty until a real key is available.
AMAP_STATIC_MAP_KEY=

# Local testing defaults. Docker Compose overrides WEB_HOST to 0.0.0.0 inside
# the container, binds host port 8080 to 127.0.0.1 only, and requires dashboard
# authentication. Nginx is the only public entry point.
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_THREADS=24
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Set true on every public deployment, including the current public-IP/HTTP
# course demo. Use a unique temporary password until HTTPS is enabled.
DASHBOARD_AUTH_REQUIRED=false
SMARTCANE_DEMO=false
